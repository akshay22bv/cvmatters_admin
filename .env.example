# CV Matters API (backend)
# Local: leave as localhost — Vite proxies /api automatically.
# Production build (Vercel): set to the live API, e.g. https://cvmattersbackend.vercel.app
VITE_API_ORIGIN=http://127.0.0.1:4000
# Public CV site — links to hosted resumes open here
VITE_APP_ORIGIN=http://127.0.0.1:3000
VITE_PORT=5174

